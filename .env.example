# ==============================================================================
# Taskman Application - Template de Orquestração Docker
# Renomeie para .env e preencha com as suas configurações sensíveis
# ==============================================================================

# Banco de Dados PostgreSQL
POSTGRES_DB=taskmanager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=altere_para_uma_senha_forte
POSTGRES_PORT=5432

# Backend Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/taskmanager
BACKEND_PORT=8080

# Segurança & Autenticação JWT (Chave HMAC-SHA256 em Hex ou Base64 com no mínimo 256 bits)
JWT_SECRET_KEY=sua_chave_secreta_jwt_minimo_256_bits_aqui
JWT_EXPIRATION=86400000

# Integração de Inteligência Artificial (Ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Frontend React
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080

